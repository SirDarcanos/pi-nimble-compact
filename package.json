{
  "name": "@sirdarcanos/pi-nimble-compact",
  "version": "0.1.0",
  "description": "Automatic Nimble context clearing for Pi. Keep the conversation, prune stale tool output, retrieve originals without rerunning commands.",
  "type": "module",
  "license": "MIT",
  "author": "SirDarcanos",
  "contributors": ["Nour Helmi", "tamaratran"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirDarcanos/pi-nimble-compact.git"
  },
  "homepage": "https://github.com/SirDarcanos/pi-nimble-compact#readme",
  "bugs": {
    "url": "https://github.com/SirDarcanos/pi-nimble-compact/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "nimble",
    "bespoke",
    "ollama",
    "compaction",
    "context"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "licenses"
  ],
  "pi": {
    "extensions": [
      "./extensions/nimble.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test tests/nimble.test.ts tests/sdk.test.ts tests/package.test.ts tests/nimble-api.test.ts tests/batching-controls.test.ts tests/excerpt-strategies.test.ts tests/truncated-projection.test.ts && vitest run tests/engine.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:ollama": "PI_NIMBLE_LIVE=1 node --import tsx --test --test-name-pattern='live local Ollama' tests/nimble-api.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typebox": "1.3.24",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
